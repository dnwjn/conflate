{
    "name": "conflate",
    "private": true,
    "version": "0.1.2",
    "type": "module",
    "packageManager": "pnpm@12.15.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "tauri": "tauri",
        "dev:stub": "VITE_STUB_UPDATE=1 tauri dev -- -- \"$PWD/dev-fixtures/sample/base.ts\" \"$PWD/dev-fixtures/sample/local.ts\" \"$PWD/dev-fixtures/sample/remote.ts\" /tmp/conflate-merged.ts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx,json,jsonc}": [
            "biome check --write --no-errors-on-unmatched"
        ]
    },
    "dependencies": {
        "@codemirror/commands": "^6.11.1",
        "@codemirror/language": "^6.13.1",
        "@codemirror/language-data": "^6.5.2",
        "@codemirror/merge": "^6.12.3",
        "@codemirror/state": "^6.7.6",
        "@codemirror/view": "^6.43.15",
        "@lezer/highlight": "^1.2.5",
        "@tauri-apps/api": "^2",
        "@tauri-apps/plugin-opener": "^2",
        "@tauri-apps/plugin-process": "^2.4.0",
        "@tauri-apps/plugin-store": "^2.5.0",
        "@tauri-apps/plugin-updater": "^2.14.1"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@tauri-apps/cli": "^2",
        "husky": "^9.1.7",
        "jsdom": "^30.1.3",
        "lint-staged": "^17.6.0",
        "typescript": "~6.0.3",
        "vite": "^8.0.16",
        "vitest": "^5.0.5"
    }
}
