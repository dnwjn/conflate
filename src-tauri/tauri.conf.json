{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conflate",
  "version": "0.1.0",
  "identifier": "dev.dnwjn.conflate",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Conflate",
        "width": 800,
        "height": 600,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2MEVEOUY5NjQ1ODkzQTcKUldTbmsxaGsrZGtPQnZaampBK3lGclhXWjQvdnVxUVFsWHB1dkhpR3V2NE1Ga0sydHY5VWtIcHEK",
      "endpoints": [
        "https://github.com/dnwjn/conflate/releases/latest/download/latest.json"
      ]
    }
  }
}
